# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values. .env is gitignored.
# Every value here can also be passed as a CLI flag (flag > env > .env > default).
# See ADAPTING.md for what to change per project.
# ---------------------------------------------------------------------------

# Archive RPC for the chain. REQUIRED for snapshots (reads HISTORICAL balances).
# Alchemy free provides archive on Base. Get a key at alchemy.com.
# (For the one-time claim-event scan you can override with a wide-getLogs public
#  RPC, e.g.  --rpc https://base.publicnode.com)
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# The reward token you are tracking (TEA_TOKEN preferred; AORA_TOKEN also accepted).
# Example below = $TEA on Base (18 decimals).
TEA_TOKEN=0xa1a0b2e02b0e6830ad5a4a7211691200945d8919
TEA_DECIMALS=18

# The contract that emits the claim event (bribe / VotingReward / distributor).
# ⚠️ If this is NOT an Aerodrome-style VotingReward, verify the event decode —
#    see ADAPTING.md Tier 2 §1.
VOTING_REWARD=0xe3460df40a682175972781a1b1330eaba3542118

# DEX factory + voter (only used to resolve the CL gauge for staked LP).
AERODROME_FACTORY=0x420dd381b31aef6683db6b902084cb0ffece40da
AERODROME_VOTER=0x16613524e02ad97edfef371bc883f2f5d6c480a5

# Liquidity pool address(es), comma-separated. v2 OR concentrated-liquidity both
# work; token0/token1 ordering and pool type are auto-detected.
# Example = USDC/TEA CL/Slipstream pool (TEA is token1).
POOLS=0xabe1f289107c20081f591bb3972b8289add64f6c

# Count only gauge-STAKED CL positions for LP (matches the Dune methodology).
LP_STAKED_ONLY=true

# Accumulate claimed per block from on-chain claim events (AORA-style ramp).
# false => stamp each wallet's fixed lifetime total onto every block.
CUMULATIVE_CLAIMED=true

# Snapshot window + cadence (launch block -> now; 3600 ≈ a couple hours on Base).
START_BLOCK=46870929
END_BLOCK=47050128
STEP_BLOCKS=3600

# Minimum TOTAL claimed (token units) to include a wallet (Dune HAVING clause).
MIN_CLAIMED=1000000

# RPC politeness + getLogs chunking.
RATE_PER_SECOND=8
MAX_RETRIES=6
CHUNK_BLOCKS=50000

# Multicall3 batching (0xcA11bde05977b3631167028862bE2a173976CA11 on Base).
USE_MULTICALL=true
MULTICALL_BATCH=500

# Output directory.
OUT_DIR=./data

# Dune upload (optional; used by `upload-dune`). Get a key at dune.com.
# DUNE_API_KEY=
# DUNE_TABLE=tea_claimers
